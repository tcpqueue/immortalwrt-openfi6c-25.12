+/* Recirculated packets have no physical ingress GMAC. */
+static bool mtk_is_rx_ppd(u32 sport, u32 reason)
+{
+	return sport == PSE_QDMA_TX_PORT ||
+	       (reason == MTK_PPE_CPU_REASON_HIT_BIND_FORCE_CPU &&
+		(sport == PSE_WDMA0_PORT || sport == PSE_WDMA1_PORT ||
+		 sport == PSE_WDMA2_PORT));
+}
+
+static int mtk_rx_ppd_mac(struct mtk_eth *eth)
+{
+	int mac;
+
+	/* Preserve MAC0 when present; boards may expose only MAC1 or MAC2. */
+	for (mac = 0; mac < MTK_MAX_DEVS; mac++)
+		if (eth->netdev[mac])
+			break;
+
+	return mac;
+}
