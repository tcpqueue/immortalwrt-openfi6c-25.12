#!/bin/sh
# The 2026-10-14 firmware shipped the Orchard theme instead of Aurora. Drop its
# leftover registration and fall back to Aurora when the selected theme is gone.
ROOT=${OPENFI_ROOT:-}
[ "$(cat "$ROOT/tmp/sysinfo/board_name" 2>/dev/null)" = 'openfi,6c' ] || exit 0
[ -d "$ROOT/www/luci-static/orchard" ] || uci -q delete luci.themes.Orchard
current=$(uci -q get luci.main.mediaurlbase)
if [ -z "$current" ] || [ ! -d "$ROOT/www$current" ]; then
    [ -d "$ROOT/www/luci-static/aurora" ] && uci set luci.main.mediaurlbase=/luci-static/aurora
fi
uci -q delete luci.main.openfi_theme
uci commit luci
exit 0
