#!/bin/sh /etc/rc.common
START=99
STOP=13
USE_PROCD=1

service_triggers() {
    procd_add_reload_trigger "openfi"
}

start_service() {
    procd_open_instance fan
    procd_set_param command /usr/sbin/op_fan.sh
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 5
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance led
    procd_set_param command /usr/sbin/op_led.sh
    procd_set_param respawn
    procd_close_instance

    apply_modem_reset
}

apply_modem_reset() {
    # Applying a fan setting must not reconfigure ports or reset the modem.
    local reset_config
    reset_config="$(uci -q show openfi.reset)"
    if [ "$reset_config" != "$(cat /var/run/openfi-reset.config 2>/dev/null)" ]; then
        /usr/sbin/op_reset_modem.sh &&
            printf '%s\n' "$reset_config" > /var/run/openfi-reset.config
    fi
}

reload_service() {
    # Keep PWM ownership and the current output while reloading fan settings.
    # The LED/switch worker already reads its settings on every iteration.
    if procd_running openfi fan && procd_send_signal openfi fan HUP; then
        apply_modem_reset
    else
        start
    fi
}
