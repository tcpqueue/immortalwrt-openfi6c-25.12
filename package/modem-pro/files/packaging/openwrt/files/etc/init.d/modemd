#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
	local config=/etc/modemd/config.toml

	procd_open_instance
	procd_set_param command /usr/bin/modemd -config "$config"
	procd_set_param file "$config"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
